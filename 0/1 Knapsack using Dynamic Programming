from functools import lru_cache


# =========================================================
# TOP-DOWN APPROACH - MEMOIZATION
# =========================================================

def knapsack_top_down(weights, values, capacity):
    n = len(weights)

    @lru_cache(maxsize=None)
    def solve(i, remaining_capacity):

        # Base condition
        if i == n or remaining_capacity == 0:
            return 0

        # If current item is too heavy, skip it
        if weights[i] > remaining_capacity:
            return solve(i + 1, remaining_capacity)

        # Two choices:
        # 1. Include the item
        include = values[i] + solve(
            i + 1,
            remaining_capacity - weights[i]
        )

        # 2. Exclude the item
        exclude = solve(i + 1, remaining_capacity)

        return max(include, exclude)

    max_value = solve(0, capacity)

    # Find selected items
    selected = []
    remaining = capacity

    for i in range(n):
        if weights[i] <= remaining:

            include = values[i] + solve(
                i + 1,
                remaining - weights[i]
            )

            exclude = solve(i + 1, remaining)

            if include >= exclude:
                selected.append(i)
                remaining -= weights[i]

    return max_value, selected


# =========================================================
# BOTTOM-UP APPROACH - TABULATION
# =========================================================

def knapsack_bottom_up(weights, values, capacity):

    n = len(weights)

    # DP table
    dp = [[0] * (capacity + 1) for _ in range(n + 1)]

    # Build table
    for i in range(1, n + 1):

        weight = weights[i - 1]
        value = values[i - 1]

        for w in range(capacity + 1):

            # Exclude current item
            dp[i][w] = dp[i - 1][w]

            # Include current item if possible
            if weight <= w:
                dp[i][w] = max(
                    dp[i][w],
                    value + dp[i - 1][w - weight]
                )

    # Backtrack to find selected items
    selected = []
    w = capacity

    for i in range(n, 0, -1):

        if dp[i][w] != dp[i - 1][w]:

            selected.append(i - 1)
            w -= weights[i - 1]

    selected.reverse()

    return dp[n][capacity], selected


# =========================================================
# MAIN PROGRAM
# =========================================================

print("----- 0/1 KNAPSACK PROBLEM -----")

n = int(input("Enter number of items: "))

weights = []
values = []

for i in range(n):
    print(f"\nItem {i + 1}")

    weight = int(input("Enter weight: "))
    value = int(input("Enter value: "))

    weights.append(weight)
    values.append(value)

capacity = int(input("\nEnter maximum capacity: "))


# Top-Down
top_value, top_items = knapsack_top_down(
    weights, values, capacity
)


# Bottom-Up
bottom_value, bottom_items = knapsack_bottom_up(
    weights, values, capacity
)


# =========================================================
# DISPLAY RESULTS
# =========================================================

print("\n========== RESULTS ==========")

print("\nTop-Down (Memoization)")
print("Maximum Value :", top_value)
print("Selected Items:", [i + 1 for i in top_items])

print("\nBottom-Up (Tabulation)")
print("Maximum Value :", bottom_value)
print("Selected Items:", [i + 1 for i in bottom_items])

print("\nSelected Item Details:")

for i in bottom_items:
    print(
        f"Item {i + 1}: "
        f"Weight = {weights[i]}, "
        f"Value = {values[i]}"
    )
