from functools import lru_cache
import time


# ---------------- MEMOIZATION ----------------
# Top-Down Dynamic Programming
@lru_cache(maxsize=None)
def fibonacci_memo(n):
    if n < 0:
        raise ValueError("n must be a non-negative integer")

    if n <= 1:
        return n

    return fibonacci_memo(n - 1) + fibonacci_memo(n - 2)


# ---------------- TABULATION ----------------
# Bottom-Up Dynamic Programming
def fibonacci_tab(n):
    if n < 0:
        raise ValueError("n must be a non-negative integer")

    if n <= 1:
        return n

    dp = [0] * (n + 1)
    dp[1] = 1

    for i in range(2, n + 1):
        dp[i] = dp[i - 1] + dp[i - 2]

    return dp[n]


# ---------------- SPACE OPTIMIZED ----------------
def fibonacci_optimized(n):
    if n < 0:
        raise ValueError("n must be a non-negative integer")

    a, b = 0, 1

    for _ in range(n):
        a, b = b, a + b

    return a


# ---------------- MAIN PROGRAM ----------------
n = int(input("Enter the value of n: "))

start = time.perf_counter()
memo_result = fibonacci_memo(n)
memo_time = time.perf_counter() - start

start = time.perf_counter()
tab_result = fibonacci_tab(n)
tab_time = time.perf_counter() - start

start = time.perf_counter()
optimized_result = fibonacci_optimized(n)
optimized_time = time.perf_counter() - start


print("\n----- RESULTS -----")
print(f"Fibonacci({n}) using Memoization : {memo_result}")
print(f"Fibonacci({n}) using Tabulation  : {tab_result}")
print(f"Fibonacci({n}) Optimized          : {optimized_result}")

print("\n----- EXECUTION TIME -----")
print(f"Memoization : {memo_time:.8f} seconds")
print(f"Tabulation  : {tab_time:.8f} seconds")
print(f"Optimized   : {optimized_time:.8f} seconds")

print("\n----- MEMOIZATION CACHE -----")
print(fibonacci_memo.cache_info())
